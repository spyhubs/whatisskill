local function C_a()
local script = G2L["a"];
	-- LocalScript in StarterPlayerScripts
	
	local UserInputService = game:GetService("UserInputService")
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	
	local maxJumps = 999 -- Set to a high number like 999 for "infinite"
	local jumpsUsed = 0
	local canJump = true
	
	local function onJumpRequest()
		if not canJump or jumpsUsed >= maxJumps then
			return
		end
	
		-- Check if the player is already in the air (Freefall or Jumping)
		-- This prevents spamming jump while on the ground after initial jump
		if humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
			jumpsUsed = jumpsUsed + 1
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping) -- Force the jump
			print("Jumped again! Jumps used:", jumpsUsed)
		end
	end
	
	local function onStateChanged(oldState, newState)
		-- Reset jumps when landing on the ground
		if newState == Enum.HumanoidStateType.Landed then
			jumpsUsed = 0
			print("Landed! Jumps reset.")
		end
	end
	
	-- Connect events
	UserInputService.JumpRequest:Connect(onJumpRequest)
	humanoid.StateChanged:Connect(onStateChanged)
	
	print("Infinite Jump Script Loaded!")
	
end;
