--// Prison Life Client Admin
--// Prefix: ;

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local prefix = ";"

-- State
local god, antiTase, antiArrest, flying, noclip = false, false, false, false, false
local bv, bg

local function char()
    return player.Character or player.CharacterAdded:Wait()
end

--====================
-- GODMODE (client)
--====================
local function enableGod()
    god = true
    local hum = char():WaitForChild("Humanoid")
    hum.HealthChanged:Connect(function()
        if god then hum.Health = hum.MaxHealth end
    end)
end
local function disableGod() god = false end

--====================
-- ANTI TASE (client)
--====================
local function enableAntiTase()
    antiTase = true
    local hum = char():WaitForChild("Humanoid")
    hum.StateChanged:Connect(function(_, s)
        if antiTase and (s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.Physics
        or s == Enum.HumanoidStateType.FallingDown) then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

--====================
-- ANTI ARREST (client)
--====================
local function enableAntiArrest()
    antiArrest = true
    for _, v in pairs(char():GetDescendants()) do
        if v:IsA("TouchTransmitter") then
            v:Destroy()
        end
    end
end

--====================
-- FLY
--====================
local function fly()
    if flying then return end
    flying = true
    local root = char():WaitForChild("HumanoidRootPart")
    bv = Instance.new("BodyVelocity", root)
    bg = Instance.new("BodyGyro", root)
    bv.MaxForce = Vector3.new(1e9,1e9,1e9)
    bg.MaxTorque = Vector3.new(1e9,1e9,1e9)

    RunService.RenderStepped:Connect(function()
        if not flying then return end
        local cam = workspace.CurrentCamera
        local vel =
            (UIS:IsKeyDown(Enum.KeyCode.W) and cam.CFrame.LookVector or Vector3.zero) +
            (UIS:IsKeyDown(Enum.KeyCode.S) and -cam.CFrame.LookVector or Vector3.zero) +
            (UIS:IsKeyDown(Enum.KeyCode.A) and -cam.CFrame.RightVector or Vector3.zero) +
            (UIS:IsKeyDown(Enum.KeyCode.D) and cam.CFrame.RightVector or Vector3.zero)
        bv.Velocity = vel * 60
        bg.CFrame = cam.CFrame
    end)
end

local function unfly()
    flying = false
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
end

--====================
-- NOCLIP
--====================
RunService.Stepped:Connect(function()
    if noclip then
        for _, p in pairs(char():GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

--====================
-- RESPAWN SAFETY
--====================
player.CharacterAdded:Connect(function()
    task.wait(0.3)
    if antiTase then enableAntiTase() end
    if antiArrest then enableAntiArrest() end
    if god then enableGod() end
end)

--====================
-- COMMAND HANDLER
--====================
player.Chatted:Connect(function(msg)
    if msg:sub(1, #prefix) ~= prefix then return end
    local args = msg:sub(#prefix + 1):lower():split(" ")
    local cmd = args[1]

    if cmd == "speed" then
        char():WaitForChild("Humanoid").WalkSpeed = tonumber(args[2]) or 16

    elseif cmd == "jump" then
        char():WaitForChild("Humanoid").JumpPower = tonumber(args[2]) or 50

    elseif cmd == "fly" then
        fly()

    elseif cmd == "unfly" then
        unfly()

    elseif cmd == "noclip" then
        noclip = true

    elseif cmd == "clip" then
        noclip = false

    elseif cmd == "god" then
        enableGod()

    elseif cmd == "ungod" then
        disableGod()

    elseif cmd == "antitase" then
        enableAntiTase()

    elseif cmd == "antiarrest" then
        enableAntiArrest()

    elseif cmd == "rejoin" then
        TeleportService:Teleport(game.PlaceId, player)

    elseif cmd == "reset" then
        char():BreakJoints()
    end
end)

print("Prison Life Client Admin Loaded | Prefix: ;")
